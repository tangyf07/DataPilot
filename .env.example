# LLM: mock (default, no key) | openai
DATAPILOT_LLM_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Query backend
DATAPILOT_DB_PATH=./data/datapilot.duckdb

# SQLGuard: mock | write_gate
DATAPILOT_GUARD_MODE=mock

# Observability
DATAPILOT_TRACE_DIR=./traces
