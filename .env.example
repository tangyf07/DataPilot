# LLM modes (canonical): real | rules | degraded
# Aliases: openai → real, mock → rules
# Default when unset: OPENAI_API_KEY present → real, else rules
# real: call OpenAI-compatible API; on failure → explicit degraded (never silent "real")
# rules: deterministic keyword/rules SQL (offline, no API key)
# degraded: forced rules path labeled degraded (or auto after real failure)
DATAPILOT_LLM_MODE=rules
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Query backend: duckdb | doris | auto (doris if DATAPILOT_DORIS_URL reachable)
DATAPILOT_QUERY_BACKEND=auto
DATAPILOT_DB_PATH=./data/datapilot.duckdb
# GameStream Doris FE (MySQL protocol). Default used by `python -m datapilot g7`
DATAPILOT_DORIS_URL=mysql://root@127.0.0.1:9030/ads

# SQLGuard: auto (prefer real 1.1) | write_gate | http | mock
DATAPILOT_GUARD_MODE=auto
DATAPILOT_GUARD_URL=
DATAPILOT_GUARD_CATALOG=./data/sqlguard/catalog.json
DATAPILOT_GUARD_POLICY=./data/sqlguard/policy.yaml

# Observability
DATAPILOT_TRACE_DIR=./traces

# Optional GameStream metrics yaml
DATAPILOT_GAMESTREAM_METRICS=./data/gamestream/metrics.yaml
